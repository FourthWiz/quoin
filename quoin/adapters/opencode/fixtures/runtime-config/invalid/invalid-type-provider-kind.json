{
  "schema_version": 1,
  "runtime": "opencode",
  "profile": "work",
  "classification": "work",
  "providers": {
    "corp-gw": {
      "kind": "other-kind",
      "endpoint_family": "chat-completions",
      "base_url": "https://gateway.example.invalid/v1",
      "credential_ref": "keychain:quoin/work-gateway",
      "name": "Corporate gateway"
    },
    "corp-gw-b": {
      "kind": "openai-compatible",
      "endpoint_family": "responses",
      "base_url": "https://gateway-b.example.invalid/v1",
      "credential_ref": "env:QUOIN_CORP_GW_B_API_KEY",
      "use_env_proxy": true
    }
  },
  "models": {
    "work-coder": {
      "provider": "corp-gw",
      "model_id": "example-vendor/example-coder",
      "qualification_ref": "local:work-coder"
    },
    "work-planner": {
      "provider": "corp-gw-b",
      "model_id": "example-vendor/example-planner",
      "qualification_ref": "local:work-planner"
    }
  },
  "default_model": "work-coder",
  "auxiliary_model": "work-planner",
  "roles": {
    "coordinator": {
      "model": "work-planner",
      "effort": "high"
    },
    "investigator": {
      "model": "work-coder",
      "effort": "medium"
    },
    "architect": {
      "model": "work-planner",
      "effort": "max"
    },
    "planner": {
      "model": "work-planner",
      "effort": "high"
    },
    "implementer": {
      "model": "work-coder",
      "effort": "medium"
    },
    "critic": {
      "model": "work-planner",
      "effort": "high"
    },
    "reviewer": {
      "model": "work-planner",
      "effort": "high"
    },
    "gate": {
      "model": "work-coder",
      "effort": "low"
    }
  },
  "policy": {
    "allowed_providers": [
      "corp-gw",
      "corp-gw-b"
    ],
    "denied_providers": [
      "retired-gw"
    ],
    "allowed_hosts": [
      "gateway.example.invalid",
      "gateway-b.example.invalid"
    ],
    "denied_hosts": [
      "untrusted.example.invalid"
    ],
    "sharing": "deny",
    "external_writes": "approval-required",
    "isolation": "managed",
    "cross_profile_fallback": false
  },
  "limits": {
    "max_run_seconds": 3600,
    "max_tool_calls": 200,
    "max_context_tokens": 128000,
    "max_output_tokens": 8192,
    "max_transient_retries": 3
  },
  "integrations": {
    "backend": "corp-gw",
    "enabled": [
      "jira",
      "slack"
    ],
    "mode": "read-only"
  }
}
