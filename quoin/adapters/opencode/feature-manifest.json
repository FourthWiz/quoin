{
  "schema_version": 2,
  "feature_name": "opencode-project-assets",
  "adapter": "opencode",
  "status": "generated-offline-verified",
  "description": "Catalog manifest classifying all 32 portable Quoin workflow skills for the OpenCode adapter, with per-entry support status, generated-name mapping and a drift check against the portable catalog. The generator, installer and doctor for the supported entries are implemented and offline-verified; live runtime evidence is not yet collected.",
  "opencode_version": "1.18.32",
  "entrypoints": [
    {
      "type": "module",
      "path": "python -m quoin.opencode_adapter check-manifest",
      "args": [
        "--source-dir <path>"
      ]
    },
    {
      "type": "cli",
      "path": "quoin install --runtime opencode",
      "args": [
        "--project-root <path>",
        "--profile <label>",
        "--check"
      ]
    },
    {
      "type": "cli",
      "path": "quoin opencode uninstall",
      "args": [
        "--project-root <path>",
        "--dry-run"
      ]
    },
    {
      "type": "cli",
      "path": "quoin opencode script",
      "args": [
        "<name> [args...]"
      ]
    },
    {
      "type": "cli",
      "path": "quoin doctor --runtime opencode",
      "args": [
        "--project-root <path>",
        "--smoke",
        "--json"
      ]
    }
  ],
  "portable_inputs": [
    {
      "path": "quoin/core/workflow/skills.json",
      "description": "Canonical skill catalog: id, phase, effort, user-facing and spawn-target flags for all 32 portable skills"
    },
    {
      "path": "quoin/core/skills/*.md",
      "description": "Portable per-skill workflow contracts referenced by the generated command and skill assets"
    },
    {
      "path": "quoin/core/workflow/rules.md",
      "description": "Portable workflow rules source for the generated instruction document"
    }
  ],
  "generated_outputs": [
    {
      "path": ".opencode/commands/quoin-*.md",
      "description": "One command per supported skill, binding to its role's agent"
    },
    {
      "path": ".opencode/skills/quoin-*/SKILL.md",
      "description": "One skill per supported entry, assembled from its bundle contract and overlay"
    },
    {
      "path": ".opencode/agents/quoin-*.md",
      "description": "One agent per Quoin role, carrying its permission map and prompt"
    },
    {
      "path": ".opencode/quoin/instructions.md",
      "description": "The rendered instruction document OpenCode loads project-wide"
    },
    {
      "path": ".opencode/opencode.jsonc",
      "description": "The generated config file pointing OpenCode at the instruction document"
    }
  ],
  "unsupported_outputs": [
    {
      "name": "global OpenCode install",
      "reason": "Only project-local .opencode assets are generated; global install paths are out of scope"
    },
    {
      "name": "provider, model, policy, plugin and MCP configuration",
      "reason": "The adapter owns asset generation and name translation only, never provider or process configuration"
    },
    {
      "name": "model pinning in agent files",
      "reason": "Generated agent frontmatter carries no model key, so nothing pins or leaks to a provider"
    }
  ],
  "validation": {
    "commands": [
      "PYTHONPATH=src python3 -m quoin.opencode_adapter check-manifest --source-dir quoin",
      "python3 -m pytest quoin/dev/tests/test_opencode_manifest.py",
      "python3 -m pytest quoin/dev/tests/test_opencode_generate.py",
      "python3 -m pytest quoin/dev/tests/test_opencode_install.py",
      "python3 -m pytest quoin/dev/tests/test_opencode_script_runner.py",
      "python3 -m pytest quoin/dev/tests/test_opencode_doctor.py",
      "python3 -m pytest quoin/dev/tests/test_opencode_doctor_host.py",
      "python3 -m pytest quoin/dev/tests/test_opencode_doctor_census.py",
      "python3 -m pytest quoin/dev/tests/test_opencode_import_order.py",
      "python3 -m pytest quoin/dev/tests/test_opencode_binary_contract.py"
    ],
    "notes": "Run from the repository root."
  },
  "milestones": [
    "adapter-foundation",
    "workflow-execution",
    "work-context",
    "controlled-writes",
    "release-hardening",
    "none"
  ],
  "roles": {
    "coordinator": {
      "mode": "primary",
      "summary": "Runs write-capable commands and persists findings returned by critic and reviewer subagents"
    },
    "investigator": {
      "mode": "all",
      "summary": "Runs discovery and serves as a read-mostly delegation target"
    },
    "architect": {
      "mode": "primary",
      "summary": "Writes architecture artifacts for a task"
    },
    "planner": {
      "mode": "primary",
      "summary": "Plans and revises in-loop for plan and thorough-plan"
    },
    "implementer": {
      "mode": "primary",
      "summary": "Edits within the project to implement a converged plan"
    },
    "critic": {
      "mode": "subagent",
      "summary": "Critiques a plan with no write and no shell access"
    },
    "reviewer": {
      "mode": "subagent",
      "summary": "Reviews an implementation with no write and no shell access"
    },
    "gate": {
      "mode": "primary",
      "summary": "Runs deterministic validators and enforces the quality gate"
    }
  },
  "limits": {
    "delegation_depth": {
      "value": 1,
      "enforcement": "enforced-natively",
      "note": "OpenCode default subagent_depth; not live-tested"
    },
    "concurrency": {
      "implementer": 1,
      "review_worker": 1,
      "enforcement": "declared-not-enforced",
      "note": "No verified native concurrency cap; parallel Task calls within one turn remain possible"
    }
  },
